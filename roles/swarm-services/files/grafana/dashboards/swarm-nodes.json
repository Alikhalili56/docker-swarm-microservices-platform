{
  "title": "Swarm Nodes Metrics",
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "CPU Usage (%)",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": "Prometheus",
      "targets": [{"expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "{{instance}}"}]
    },
    {
      "id": 2, "type": "timeseries", "title": "Memory Usage (%)",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": "Prometheus",
      "targets": [{"expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "{{instance}}"}]
    },
    {
      "id": 3, "type": "timeseries", "title": "Disk Usage (%)",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": "Prometheus",
      "targets": [{"expr": "100 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"} * 100)", "legendFormat": "{{instance}}"}]
    },
    {
      "id": 4, "type": "timeseries", "title": "Network Traffic",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum by(instance)(rate(node_network_receive_bytes_total{device!=\"lo\"}[5m]))", "legendFormat": "{{instance}} rx"},
        {"expr": "sum by(instance)(rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m]))", "legendFormat": "{{instance}} tx"}
      ]
    }
  ],
  "schemaVersion": 30
}
